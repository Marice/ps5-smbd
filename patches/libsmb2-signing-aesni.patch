+        uint8_t sub_key1[16], sub_key2[16], last[16];
+        uint64_t n = (msg_len + 15) / 16;
+        uint64_t rem = msg_len % 16;
+        uint64_t i;
+        int complete = n != 0 && rem == 0;
+        size_t v = 0, at = 0;
+        __m128i x = _mm_setzero_si128();
