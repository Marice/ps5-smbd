+        smb2_aesni_setup(key, rk, sub_key1, sub_key2);
+        if (n == 0) {
+                n = 1;
+        }
+        for (i = 0; i < n - 1; i++) {
+                __m128i m;
+
+                while (v < niov && at == iov[v].len) {
+                        v++;
+                        at = 0;
+                }
+                if (v < niov && iov[v].len - at >= 16) {
+                        m = _mm_loadu_si128((const __m128i *)(const void *)(iov[v].buf + at));
+                        at += 16;
+                } else {
