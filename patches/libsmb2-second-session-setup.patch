Server: once a session exists, a SESSION_SETUP on the same connection (a second session, or a
re-authentication) was parsed as a TREE_CONNECT and the connection dropped, taking the first session with
it. Parse it as what it is and refuse it with STATUS_REQUEST_NOT_ACCEPTED: this server keeps one session per
connection, and running the session setup again would put the connection back into authentication.

--- a/lib/socket.c	2026-10-30 20:25:52.671555366 +0100
+++ b/lib/socket.c	2026-10-30 20:25:52.707560691 +0100
@@ -765,7 +765,9 @@
                          * any request from the client, so use the header's command
                          * not the pdu's command for the rest of input
                          */
-                        if (smb2->hdr.command > SMB2_SESSION_SETUP) {
+                        /* SESSION_SETUP too: once a session exists, a new one was parsed as the
+                         * TREE_CONNECT the placeholder pdu stands for, and the connection dropped */
+                        if (smb2->hdr.command >= SMB2_SESSION_SETUP) {
                                 pdu->header.command = smb2->hdr.command;
                         }
                         pdu->header.credit_charge = smb2->hdr.credit_charge;
--- a/lib/libsmb2.c	2026-10-30 20:25:52.679556549 +0100
+++ b/lib/libsmb2.c	2026-10-30 20:25:52.711561282 +0100
@@ -4877,11 +4877,23 @@
         }
 
         switch (smb2->pdu->header.command) {
-        case SMB2_SESSION_SETUP:
-                smb2_session_setup_request_cb(smb2, status, command_data, cb_data);
-                /* session setup cb allocs next_pdu itself */
-                next_cb = NULL;
+        case SMB2_SESSION_SETUP: {
+                /* A second session, or a re-authentication, on a connection that has one: this
+                 * server keeps one session (one id, one signing key) per connection, and running the
+                 * session setup again would put the connection back into authentication for every
+                 * request after it. Refuse it; the session that exists goes on. */
+                struct smb2_error_reply err;
+                struct smb2_pdu *pdu;
+
+                memset(&err, 0, sizeof(err));
+                pdu = smb2_cmd_error_reply_async(smb2, &err, SMB2_SESSION_SETUP,
+                                                 SMB2_STATUS_REQUEST_NOT_ACCEPTED, NULL, cb_data);
+                if (pdu != NULL) {
+                        smb2_set_pdu_message_id(smb2, pdu, smb2->message_id);
+                        smb2_queue_pdu(smb2, pdu);
+                }
                 break;
+        }
         case SMB2_LOGOFF:
                 smb2_logoff_request_cb(server, smb2, command_data, cb_data);
                 /* prep for a new session setup req */
