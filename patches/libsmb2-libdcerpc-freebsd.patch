# libdcerpc refuses every system but Linux (its symbols collide with Microsoft's RPC libraries on Windows).
# FreeBSD, which the PS5 payload SDK targets, has no such collision; the build passes compat/ for the one
# glibc header it lacks (<endian.h>).
--- a/libdcerpc/CMakeLists.txt
+++ b/libdcerpc/CMakeLists.txt
@@ -9,7 +9,7 @@
   cmake_minimum_required(VERSION 3.10)
   project(libdcerpc VERSION ${LIBDCERPC_VERSION} LANGUAGES C)
 
-  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|FreeBSD)$")
     message(FATAL_ERROR "libdcerpc is only supported on Linux")
   endif()
 
