# libsmb2 server: FSCTL_PIPE_TRANSCEIVE (how Windows calls a DCE/RPC pipe such as srvsvc) was refused unless
# the whole context ran in passthrough mode ("No handling for ioctl req 11c017"); its input is handed over
# raw, with the client's own InputCount (already checked against the buffer).
--- a/lib/smb2-cmd-ioctl.c
+++ b/lib/smb2-cmd-ioctl.c
@@ -568,6 +568,12 @@
                 smb2_get_uint16(&vec, 22, &info->dialect);
                 req->input_count = sizeof(struct smb2_ioctl_validate_negotiate_info);
                 break;
+        case SMB2_FSCTL_PIPE_TRANSCEIVE:
+                /* the bytes written to a named pipe: nothing to decode, the
+                 * server application hands them to its pipe as they are
+                 */
+                ptr = vec.buf;
+                break;
         default:
                 if (smb2->passthrough) {
                         /* dont know how to handle this, let user decode it */
